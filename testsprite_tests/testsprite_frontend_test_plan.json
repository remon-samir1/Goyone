[
  {
    "id": "TC001",
    "title": "Search and filter leads, open details, edit a lead, and verify updated value appears in the table",
    "description": "Verifies a user can search and filter leads, edit a lead in detail view, save, and see the updated lead data reflected back in the leads table.",
    "category": "Lead Management",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /crm"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Leads\" is visible"
      },
      {
        "type": "action",
        "description": "Type \"Test\" into the leads search bar"
      },
      {
        "type": "action",
        "description": "Select \"Active\" from the Status filter dropdown"
      },
      {
        "type": "action",
        "description": "Select \"Contacted\" from the Communication State filter dropdown"
      },
      {
        "type": "action",
        "description": "Click on the first lead row in the leads table"
      },
      {
        "type": "action",
        "description": "Fill \"Updated Lead Name\" into the Lead Name field"
      },
      {
        "type": "action",
        "description": "Click on \"Save\""
      },
      {
        "type": "assertion",
        "description": "Verify text \"Updated Lead Name\" is visible"
      }
    ]
  },
